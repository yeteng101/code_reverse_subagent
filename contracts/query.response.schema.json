{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-reverse-agent.local/schemas/query.response.schema.json",
  "title": "QueryResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_type", "schema_version", "query_id", "analysis_id", "answer", "focus", "citations", "uncertainty"],
  "properties": {
    "resource_type": { "const": "query" },
    "schema_version": { "type": "string", "const": "1.0" },
    "query_id": { "type": "string", "pattern": "^q_[A-Za-z0-9_-]+$" },
    "analysis_id": { "type": "string", "pattern": "^an_[A-Za-z0-9_-]+$" },
    "answer": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "focus": { "type": "array", "items": { "type": "string", "pattern": "^n_[A-Za-z0-9_-]+$" }, "uniqueItems": true },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_ids", "edge_ids"],
        "properties": {
          "label": { "type": "string" },
          "node_ids": { "type": "array", "items": { "type": "string" } },
          "edge_ids": { "type": "array", "items": { "type": "string" } }
        }
      },
      "maxItems": 20
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "text"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "node_id": { "type": "string" },
          "edge_id": { "type": "string" }
        }
      },
      "maxItems": 32
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["has_unresolved", "items"],
      "properties": {
        "has_unresolved": { "type": "boolean" },
        "items": { "type": "array", "items": { "type": "string" } }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    }
  }
}
